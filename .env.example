# RevGuard configuration (copy to .env and fill in credentials as needed).
# All RevGuard variables use the REVGUARD_ prefix; AI/Razorpay keys use their standard names.
# The defaults make the app run fully offline (mock AI + mock payments) with zero credentials.
# .env is git-ignored — never commit real keys.

# Application
REVGUARD_APP_NAME=RevGuard
REVGUARD_ENVIRONMENT=development

# Runtime mode:
#   production -> live path: configured AI (Gemini) + Razorpay Test Mode, verified recovery
#   demo       -> clearly-labelled offline rehearsal using deterministic mocks
REVGUARD_MODE=production

# AI provider selection (the AI only *recommends*; the policy engine still gates everything):
#   groq       -> Llama 3.3 via Groq (production default; requires GROQ_API_KEY)
#   gemini     -> Google Gemini (requires GEMINI_API_KEY)
#   anthropic  -> Claude (requires ANTHROPIC_API_KEY)
#   mock       -> deterministic, no credentials (used automatically in demo mode)
REVGUARD_AI_PROVIDER=groq
REVGUARD_AI_MODEL=llama-3.3-70b-versatile

# Groq credential — required when REVGUARD_AI_PROVIDER=groq in production.
# Get one free at https://console.groq.com/keys
# GROQ_API_KEY=

# Gemini credential — only needed when REVGUARD_AI_PROVIDER=gemini.
# GEMINI_API_KEY=

# Anthropic credential — only needed when REVGUARD_AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=

# Payment execution: mock (offline) or razorpay (Test Mode only, rzp_test_ keys).
REVGUARD_PAYMENT_ADAPTER=razorpay

# Razorpay Test Mode credentials — required for the live execution/verification/webhook path.
# Only Test Mode keys (rzp_test_...) are accepted; live keys are rejected.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Persistence
REVGUARD_DATABASE_URL=sqlite:///./revguard.db
